# Copy to .env and fill in. Never commit .env.

# --- Required ---
# Neon PostgreSQL connection string (Neon console -> Branches -> Roles & Databases)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"
# Optional direct (unpooled) URL for migrations. Runtime uses DATABASE_URL.
DIRECT_URL=""

# Long random string used to sign session JWTs (e.g. `openssl rand -hex 32`)
JWT_SECRET="replace-with-a-long-random-secret"

# --- Google sign-in (Google Cloud Console -> APIs & Services -> Credentials) ---
# Create a Web application OAuth client and authorize:
#   <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Admin portal (/admin/login) ---
SUPER_ADMIN_EMAIL="admin@example.com"
# bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# The hash contains "$" which Next's env loader expands as variables. Escape every "$" as "\$":
#   SUPER_ADMIN_PASSWORD_HASH="\$2b\$10\$abc..."
SUPER_ADMIN_PASSWORD_HASH=""

# Optional: separate key for signing certificates (falls back to JWT_SECRET)
CERTIFICATE_SIGNING_KEY=""

# --- Public URL + Email (password reset, verification, certificate delivery) ---
# Local development:
APP_URL="http://localhost:3000"
# Vercel production: set this to your production/custom domain, for example:
# APP_URL="https://certitask.example.com"
# Vercel preview deployments can fall back to VERCEL_URL when APP_URL is omitted,
# but APP_URL is recommended so emailed links always use one canonical domain.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@example.com"

# --- Rate limiting (required for production; local development can use memory) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Secret for scheduled jobs (e.g. GET /api/cron/purge-documents with "Authorization: Bearer <secret>")
CRON_SECRET=""
# Optional: separate pepper for hashing government ID numbers (falls back to JWT_SECRET)
ID_HASH_PEPPER=""

# --- Billing (Safepay hosted checkout; https://getsafepay.com) ---
# "sandbox" or "production". Base URL must match the environment.
SAFEPAY_ENV="sandbox"
# Leave blank to select the correct endpoint automatically.
# Production: SAFEPAY_ENV="production"; use live keys and a live webhook secret.
SAFEPAY_BASE_URL=""
# Dashboard -> Developers -> API keys
SAFEPAY_PUBLIC_KEY=""
SAFEPAY_SECRET_KEY=""
# Dashboard -> Developers -> Webhooks -> endpoint <APP_URL>/api/safepay/webhook (shared secret)
SAFEPAY_WEBHOOK_SECRET=""
# Optional price overrides in US cents (defaults: 500 / 1000 / 2000) and free posts per verified client (default 2)
PLAN_PRICE_STARTER_CENTS=""
PLAN_PRICE_GROWTH_CENTS=""
PLAN_PRICE_PRO_CENTS=""
FREE_POSTS=""

# --- Certificates (optional). Print a human signatory next to the digital signature block.
# Both must be set and public/signature.png must exist; otherwise only the HMAC fingerprint + QR are printed.
CERTIFICATE_SIGNATORY_NAME=""
CERTIFICATE_SIGNATORY_TITLE=""
